---
import { careers, specialOptions, author } from '../data/careers.js';
---

<footer class="border-t border-rule bg-paper mt-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <div>
        <h3 class="text-base font-bold text-ink mb-4">Career Risk Assessments</h3>
        <ul class="space-y-2">
          {
            careers.map((career) => (
              <li>
                <a
                  href={`/risk/${career.slug}/`}
                  class="text-muted hover:text-accent transition-colors text-sm"
                >
                  {career.title} AI Risk — {career.baseRiskScore}%
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="text-base font-bold text-ink mb-4">Special Resources</h3>
        <ul class="space-y-2">
          {
            specialOptions.map((option) => (
              <li>
                <a
                  href={`/special/${option.value}/`}
                  class="text-muted hover:text-accent transition-colors text-sm"
                >
                  {option.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="text-base font-bold text-ink mb-4">About</h3>
        <ul class="space-y-2">
          <li>
            <a href="/about/" class="text-muted hover:text-accent transition-colors text-sm"
              >About This Tool</a
            >
          </li>
          <li>
            <a href="/#methodology" class="text-muted hover:text-accent transition-colors text-sm"
              >Methodology</a
            >
          </li>
          <li>
            <a
              href="/study/ai-job-impact-2026/"
              class="text-muted hover:text-accent transition-colors text-sm"
              >AI Job Impact 2026 (Stanford Data)</a
            >
          </li>
          <li>
            <a
              href="/study/careers-by-industry/"
              class="text-muted hover:text-accent transition-colors text-sm"
              >AI Risk by Industry Sector</a
            >
          </li>
          <li>
            <a
              href="/data/ai-career-risk-index/"
              class="text-muted hover:text-accent transition-colors text-sm"
              >AI Career Risk Index (Open Data)</a
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="text-center text-sm text-muted pt-8 border-t border-rule">
      <p class="mb-1">© 2026 aicareer.me — Free AI Career Risk Assessment Tool</p>
      <p>Built by {author.name} · Based on research from Oxford, McKinsey & WEF</p>
    </div>
  </div>
</footer>
