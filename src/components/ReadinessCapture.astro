---
import { emailCapture } from '../data/config.js';

// Email capture for the HI-C surfaces. Offers the readiness self-assessment PDF.
//
// Two deliberate choices for the audience that judges the site's legitimacy
// (PERSONA.md §4):
//   1. No urgency, no "FREE!" badge, no dark pattern. The offer is an artifact
//      that is useful on its own, framed as exactly that.
//   2. On success the page reveals the direct download link. So delivery never
//      depends on the MailerLite automation being wired for this segment, and
//      the interaction reads as "instant access" rather than "check your inbox
//      and hope". The email is still captured; the reveal is the delivery.
const formActive = Boolean(emailCapture.action);
const pdfUrl = '/reports/hi-c-readiness.pdf';
const segment = 'hi-c-readiness';
---

<section
  class="mb-12 rounded-xl border border-rule bg-surface p-8"
  aria-labelledby="readiness-heading"
>
  <h2 id="readiness-heading" class="mb-2 text-2xl font-bold text-ink">
    Where do you actually stand?
  </h2>
  <p class="measure mb-5 text-sm leading-relaxed text-muted">
    A one-page self-assessment: score yourself 1–5 on each of the five dimensions, read the lower-
    and higher-end anchors, and see where your largest gap is — because that gap is your next move.
    It cites the framework by DOI, so every claim in it is verifiable.
  </p>

  {
    formActive ? (
      <div>
        <form
          data-readiness-form
          action={emailCapture.action}
          method="post"
          class="flex flex-col gap-3 sm:flex-row"
        >
          <label class="sr-only" for="readiness-email">
            Email address
          </label>
          <input
            id="readiness-email"
            type="email"
            name={emailCapture.emailField}
            required
            placeholder="you@example.com"
            class="flex-1 rounded-lg border border-rule bg-paper px-4 py-3 text-ink placeholder-muted transition-colors focus:border-accent focus:outline-none"
          />
          <input type="hidden" name={emailCapture.careerField} value={segment} />
          <button
            type="submit"
            data-submit-label="Get the assessment"
            class="rounded-lg px-6 py-3 font-bold text-on-accent transition-colors disabled:opacity-60"
            style="background: linear-gradient(135deg, rgb(var(--accent-solid)) 0%, rgb(var(--accent-deep)) 100%)"
          >
            Get the assessment
          </button>
        </form>
        <div
          data-readiness-success
          hidden
          class="rounded-lg border border-risk-low/30 bg-risk-low/5 px-4 py-4"
        >
          <p class="mb-2 text-sm font-medium text-risk-low">✓ You're in. Access it now:</p>
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-bold text-on-accent"
            style="background: linear-gradient(135deg, rgb(var(--accent-solid)) 0%, rgb(var(--accent-deep)) 100%)"
          >
            ↓ Open the assessment (PDF)
          </a>
        </div>
        <p data-readiness-error hidden class="mt-3 text-sm text-risk-high">
          Something went wrong. You can still
          <a href={pdfUrl} target="_blank" rel="noopener" class="underline">
            open the assessment directly
          </a>
          .
        </p>
      </div>
    ) : (
      <a
        href={pdfUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-lg px-6 py-3 font-bold text-on-accent"
        style="background: linear-gradient(135deg, rgb(var(--accent-solid)) 0%, rgb(var(--accent-deep)) 100%)"
      >
        ↓ Open the assessment (PDF)
      </a>
    )
  }

  <p class="mt-3 text-xs text-muted">
    No spam. Published under
    <a href={pdfUrl} target="_blank" rel="noopener" class="text-accent hover:underline">CC BY 4.0</a
    > — yours to keep and share.
  </p>
</section>

<script>
  document.addEventListener('submit', async (e) => {
    const form = e.target instanceof HTMLFormElement ? e.target : null;
    if (!form || !form.hasAttribute('data-readiness-form')) return;
    e.preventDefault();

    const wrapper = form.parentElement;
    const button = form.querySelector('button[type="submit"]');
    const successMsg = wrapper?.querySelector('[data-readiness-success]');
    const errorMsg = wrapper?.querySelector('[data-readiness-error]');

    if (errorMsg) errorMsg.hidden = true;
    if (button) {
      button.disabled = true;
      button.textContent = 'Sending…';
    }

    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const data = await res.json();
      if (!data.success) throw new Error('subscribe failed');
      form.hidden = true;
      if (successMsg) successMsg.hidden = false;
    } catch {
      if (errorMsg) errorMsg.hidden = false;
      if (button) {
        button.disabled = false;
        button.textContent = button.getAttribute('data-submit-label') || 'Get the assessment';
      }
    }
  });
</script>
