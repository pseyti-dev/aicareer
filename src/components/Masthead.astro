---
// Journal-style evidence furniture.
//
// The versioned dataset, changelog, licence and citation block are the site's
// strongest credibility signals for the audience that matters most (see
// PERSONA.md §3 — "The Returner" is the persona that cites, and citation is
// the only distribution channel in STRATEGY.md §4). They were previously
// rendered as fine print. This promotes them to something a research
// publication would print above the fold.
import { datasetMeta } from '../data/careers.js';

export interface Props {
  /** Section label shown first, e.g. "Career assessment". */
  kind?: string;
  /** Hide the citation link on the canonical page itself. */
  showCitation?: boolean;
  /**
   * Any versioned artifact carrying { version, lastUpdated, license,
   * licenseLabel, canonicalUrl }. Defaults to the AI Career Risk Index.
   */
  meta?: typeof datasetMeta;
  class?: string;
}

const {
  kind = 'AI Career Risk Index',
  showCitation = true,
  meta = datasetMeta,
  class: className = '',
} = Astro.props;

const updated = new Date(meta.lastUpdated + 'T00:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<dl class={`masthead ${className}`}>
  <div>
    <dt class="sr-only">Source</dt>
    <dd class="!ml-0 font-semibold tracking-normal">{kind}</dd>
  </div>
  <div>
    <dt>Version</dt>
    <dd>v{meta.version}</dd>
  </div>
  <div>
    <dt>Updated</dt>
    <dd><time datetime={meta.lastUpdated}>{updated}</time></dd>
  </div>
  {
    meta.doi && (
      <div>
        <dt>DOI</dt>
        <dd>
          <a
            href={meta.doiUrl}
            rel="noopener"
            target="_blank"
            class="underline decoration-rule underline-offset-2 transition-colors hover:text-accent hover:decoration-accent"
          >
            {meta.doi}
          </a>
        </dd>
      </div>
    )
  }
  <div>
    <dt>Licence</dt>
    <dd>
      <a
        href={meta.license}
        rel="license noopener"
        target="_blank"
        class="underline decoration-rule underline-offset-2 hover:decoration-accent hover:text-accent transition-colors"
        >{meta.licenseLabel}</a
      >
    </dd>
  </div>
  {
    showCitation && (
      <div>
        <dt class="sr-only">Citation</dt>
        <dd class="!ml-0">
          <a
            href={meta.canonicalUrl}
            class="underline decoration-rule underline-offset-2 transition-colors hover:text-accent hover:decoration-accent"
          >
            Cite this data
          </a>
        </dd>
      </div>
    )
  }
</dl>
