---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { transitions } from '../../data/transitions.js';
import { author } from '../../data/careers.js';
import { hicMeta, definitionShort } from '../../data/hic.js';

export function getStaticPaths() {
  return transitions.map((t) => ({ params: { track: t.slug }, props: { t } }));
}

const { t } = Astro.props;
const url = `https://aicareer.me/hi-c/from-${t.slug}/`;

// Inline emphasis over copy authored in this repository — no injection surface.
const md = (s) => s.replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-ink">$1</strong>');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: t.h1,
  description: t.metaDescription,
  url,
  author: { '@type': 'Person', name: author.name, url: author.linkedin },
  publisher: { '@type': 'Organization', name: 'aicareer.me', url: 'https://aicareer.me' },
  datePublished: '2026-08-13',
  dateModified: '2026-08-13',
  license: hicMeta.license,
  about: { '@id': hicMeta.canonicalUrl },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `${t.title}: a 90-day plan`,
  description: `A 90-day plan for moving from ${t.from} to operating as a High-Impact Individual Contributor.`,
  totalTime: 'P90D',
  step: t.plan.map((p, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: p.action,
    text: p.detail,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aicareer.me/' },
    { '@type': 'ListItem', position: 2, name: 'HI-C', item: hicMeta.canonicalUrl },
    { '@type': 'ListItem', position: 3, name: t.title, item: url },
  ],
};
---

<BaseLayout
  title={t.metaTitle}
  description={t.metaDescription}
  canonical={url}
  ogType="article"
  schema={[articleSchema, howToSchema, faqSchema, breadcrumbSchema]}
>
  <Nav />

  <div class="min-h-screen bg-paper">
    <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-x-2 text-sm text-muted">
          <li><a href="/" class="transition-colors hover:text-accent">Home</a></li>
          <li><span class="text-rule">/</span></li>
          <li><a href="/hi-c/" class="transition-colors hover:text-accent">HI-C</a></li>
          <li><span class="text-rule">/</span></li>
          <li><span class="font-medium text-ink" aria-current="page">{t.title}</span></li>
        </ol>
      </nav>

      <header class="mb-10">
        <h1 class="mb-4 text-3xl font-bold text-ink sm:text-4xl lg:text-5xl">{t.h1}</h1>
        <p class="measure mb-6 text-lg text-muted">{t.situation}</p>
        <p class="measure-wide text-base leading-relaxed text-ink">{t.lede}</p>
      </header>

      <section
        aria-labelledby="target"
        class="mb-12 rounded-xl border-l-4 border-accent bg-accent/[0.06] p-6"
      >
        <h2 id="target" class="mb-2 text-base font-bold text-ink">Where this leads</h2>
        <p class="measure text-sm leading-relaxed text-ink">
          {definitionShort}
          <a
            href="/hi-c/"
            class="ml-1 text-accent underline decoration-rule underline-offset-2 hover:decoration-accent"
            >Read the full definition →</a
          >
        </p>
      </section>

      <section aria-labelledby="transfers" class="mb-12">
        <h2 id="transfers" class="mb-4 text-2xl font-bold text-ink">What transfers</h2>
        <p class="measure mb-6 text-base leading-relaxed text-muted">
          You are not starting over. These are assets you already hold, and several of them are
          scarce among people who never left this track.
        </p>
        <dl class="space-y-3">
          {
            t.transfers.map((x) => (
              <div class="lift rounded-xl border border-rule bg-surface p-5">
                <dt class="mb-1 font-semibold text-ink">{x.asset}</dt>
                <dd class="text-sm leading-relaxed text-muted">{x.why}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="gaps" class="mb-12">
        <h2 id="gaps" class="mb-4 text-2xl font-bold text-ink">What is missing</h2>
        <p class="measure mb-6 text-base leading-relaxed text-muted">
          Stated plainly, because a transition plan built on flattery does not survive contact with
          the work.
        </p>
        <ol class="space-y-4">
          {
            t.gaps.map((g, i) => (
              <li class="rounded-xl border border-rule bg-surface p-6">
                <div class="mb-3 flex items-baseline gap-3">
                  <span class="tnum text-sm font-semibold text-accent">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="text-lg font-bold text-ink">{g.gap}</h3>
                </div>
                <p class="measure mb-3 text-sm leading-relaxed text-muted">{g.honest}</p>
                <div class="rounded-lg border border-accent/25 bg-accent/[0.06] p-3">
                  <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-accent">
                    What closes it
                  </p>
                  <p class="text-sm leading-relaxed text-ink">{g.fix}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="comp" class="mb-12">
        <h2 id="comp" class="mb-4 text-2xl font-bold text-ink">The compensation conversation</h2>
        {
          t.compensation.map((p) => (
            <p class="measure-wide mb-4 text-base leading-relaxed text-muted" set:html={md(p)} />
          ))
        }
      </section>

      <section aria-labelledby="plan" class="mb-12">
        <h2 id="plan" class="mb-4 text-2xl font-bold text-ink">A 90-day plan</h2>
        <ol class="space-y-4">
          {
            t.plan.map((p) => (
              <li class="lift rounded-xl border border-rule bg-surface p-6">
                <p class="tnum mb-2 text-xs font-semibold uppercase tracking-wider text-accent">
                  {p.window}
                </p>
                <h3 class="mb-2 text-lg font-bold text-ink">{p.action}</h3>
                <p class="measure text-sm leading-relaxed text-muted">{p.detail}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="trap" class="mb-12">
        <h2 id="trap" class="mb-4 text-2xl font-bold text-ink">The trap specific to this route</h2>
        <div class="rounded-xl border border-rule bg-paper-alt p-6">
          <h3 class="mb-2 flex items-center gap-2 text-base font-bold text-ink">
            <span class="text-risk-mid">⚠</span>
            {t.trap.name}
          </h3>
          <p class="measure-wide text-sm leading-relaxed text-muted">{t.trap.body}</p>
        </div>
      </section>

      <section aria-labelledby="faq-heading" class="mb-12">
        <h2 id="faq-heading" class="mb-6 text-2xl font-bold text-ink">
          Frequently asked questions
        </h2>
        <dl class="space-y-6">
          {
            t.faq.map((f) => (
              <div class="border-b border-rule pb-6 last:border-0">
                <dt class="mb-2 text-lg font-bold text-ink">{f.q}</dt>
                <dd class="measure-wide text-base leading-relaxed text-muted">{f.a}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="related-heading" class="mb-12">
        <h2 id="related-heading" class="mb-4 text-2xl font-bold text-ink">Keep reading</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          <li>
            <a
              href="/hi-c/"
              class="lift block rounded-xl border border-rule bg-surface p-5 font-medium text-ink transition-colors hover:border-accent"
            >
              What is a HI-C? <span class="text-accent">→</span>
            </a>
          </li>
          <li>
            <a
              href="/guides/staff-engineer-vs-manager/"
              class="lift block rounded-xl border border-rule bg-surface p-5 font-medium text-ink transition-colors hover:border-accent"
            >
              Staff engineer vs manager <span class="text-accent">→</span>
            </a>
          </li>
          {
            transitions
              .filter((o) => o.slug !== t.slug)
              .map((o) => (
                <li>
                  <a
                    href={`/hi-c/from-${o.slug}/`}
                    class="lift block rounded-xl border border-rule bg-surface p-5 font-medium text-ink transition-colors hover:border-accent"
                  >
                    {o.title} <span class="text-accent">→</span>
                  </a>
                </li>
              ))
          }
        </ul>
      </section>
    </article>
  </div>

  <Footer />
</BaseLayout>
