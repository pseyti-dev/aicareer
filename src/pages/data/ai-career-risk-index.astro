---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { careers, methodology, datasetMeta, author } from '../../data/careers.js';

const sorted = careers.slice().sort((a, b) => b.baseRiskScore - a.baseRiskScore);

const year = datasetMeta.lastUpdated.slice(0, 4);
// Citations resolve through the concept DOI, which always points at the latest
// archived version — a durable identifier that survives the domain.
const citationApa = `${author.name}. (${year}). ${datasetMeta.name} (v${datasetMeta.version}) [Data set]. aicareer.me. ${datasetMeta.doiUrl}`;
const citationBibtex = `@misc{aicareer${year},
  author    = {${author.name}},
  title     = {${datasetMeta.name} (v${datasetMeta.version})},
  year      = {${year}},
  publisher = {aicareer.me},
  doi       = {${datasetMeta.doi}},
  url       = {${datasetMeta.doiUrl}},
  note      = {Licensed under CC BY 4.0}
}`;

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: datasetMeta.name,
  version: datasetMeta.version,
  description: datasetMeta.description,
  url: datasetMeta.canonicalUrl,
  // Dataset search engines key off a resolvable identifier; the DOI is the
  // strongest one available.
  identifier: datasetMeta.doiUrl,
  sameAs: datasetMeta.doiUrl,
  license: datasetMeta.license,
  isAccessibleForFree: true,
  dateModified: datasetMeta.lastUpdated,
  temporalCoverage: '2026',
  creator: { '@type': 'Person', name: author.name },
  publisher: { '@type': 'Organization', name: 'aicareer.me', url: 'https://aicareer.me' },
  keywords: [
    'AI job displacement',
    'AI career risk',
    'automation risk by occupation',
    'AI replacing jobs',
    'labor market AI impact',
  ],
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'riskScore', description: 'AI displacement risk, 0–100%' },
    {
      '@type': 'PropertyValue',
      name: 'riskLevel',
      description: 'Risk band: Critical, High Risk, Moderate, Low Risk',
    },
  ],
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: 'text/csv',
      contentUrl: 'https://aicareer.me/data/ai-career-risk-index.csv',
    },
    {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: 'https://aicareer.me/data/ai-career-risk-index.json',
    },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aicareer.me/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: datasetMeta.name,
      item: datasetMeta.canonicalUrl,
    },
  ],
};

const getBarColor = (score) => {
  if (score <= 40) return 'rgb(var(--risk-low))';
  if (score <= 70) return 'rgb(var(--risk-mid))';
  return 'rgb(var(--risk-high))';
};
---

<BaseLayout
  title={`AI Career Risk Index ${year}: Open Dataset, 24 Careers | aicareer.me`}
  description={`Download the AI Career Risk Index v${datasetMeta.version}: AI displacement risk scores for 24 careers as open CSV/JSON data (CC BY 4.0). Methodology and citation included.`}
  canonical={datasetMeta.canonicalUrl}
  schema={[datasetSchema, breadcrumbSchema]}
>
  <Nav />

  <div class="min-h-screen bg-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-muted">
          <li><a href="/" class="hover:text-accent transition-colors">Home</a></li>
          <li><span class="mx-2 text-rule">/</span></li>
          <li>
            <span class="text-ink font-medium" aria-current="page">{datasetMeta.name}</span>
          </li>
        </ol>
      </nav>

      <div class="mb-10">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span
            class="px-3 py-1 rounded-full text-xs font-bold bg-accent/10 text-accent border border-accent/30"
            >Open Dataset</span
          >
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-rule text-ink"
            >v{datasetMeta.version}</span
          >
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-rule text-ink"
            >Updated {datasetMeta.lastUpdated}</span
          >
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-rule text-ink"
            >{datasetMeta.licenseLabel}</span
          >
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-ink mb-4">
          {datasetMeta.name}
        </h1>
        <p class="text-lg text-muted leading-relaxed mb-6">
          {datasetMeta.description}
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/data/ai-career-risk-index.csv"
            download
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-bold text-white"
            style="background: linear-gradient(135deg, rgb(var(--accent-solid)) 0%, rgb(var(--accent-deep)) 100%)"
          >
            ↓ Download CSV
          </a>
          <a
            href="/data/ai-career-risk-index.json"
            download
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-rule font-bold text-ink hover:border-accent transition-all"
          >
            ↓ Download JSON
          </a>
        </div>
      </div>

      <!-- Full data table — visible, crawlable HTML -->
      <section class="mb-12" aria-labelledby="index-table-heading">
        <h2 id="index-table-heading" class="text-2xl font-bold text-ink mb-4">
          AI Displacement Risk by Career — Full Index
        </h2>
        <div class="overflow-x-auto rounded-xl border border-rule">
          <table class="w-full text-sm">
            <caption class="sr-only">
              AI Career Risk Index: displacement risk scores for 24 careers, ranked highest to
              lowest.
            </caption>
            <thead>
              <tr class="bg-surface text-left text-muted">
                <th scope="col" class="px-4 py-3 font-medium">#</th>
                <th scope="col" class="px-4 py-3 font-medium">Career</th>
                <th scope="col" class="px-4 py-3 font-medium">Risk Score</th>
                <th scope="col" class="px-4 py-3 font-medium">Level</th>
                <th scope="col" class="px-4 py-3 font-medium hidden sm:table-cell">Assessment</th>
              </tr>
            </thead>
            <tbody>
              {
                sorted.map((c, i) => {
                  const color = getBarColor(c.baseRiskScore);
                  return (
                    <tr class="border-t border-rule">
                      <td class="px-4 py-3 text-muted">{i + 1}</td>
                      <td class="px-4 py-3 font-medium text-ink">{c.title}</td>
                      <td class="px-4 py-3">
                        <div class="flex items-center gap-3">
                          <span class="font-bold text-ink w-10">{c.baseRiskScore}%</span>
                          <div class="w-24 h-1.5 bg-rule rounded-full overflow-hidden hidden md:block">
                            <div
                              class="h-full rounded-full"
                              style={`width:${c.baseRiskScore}%;background-color:${color}`}
                            />
                          </div>
                        </div>
                      </td>
                      <td class="px-4 py-3">
                        <span
                          class="px-2 py-0.5 rounded text-xs font-bold uppercase whitespace-nowrap"
                          style={`background-color:${color}20;color:${color}`}
                        >
                          {c.riskLabel}
                        </span>
                      </td>
                      <td class="px-4 py-3 hidden sm:table-cell">
                        <a
                          href={`/risk/${c.slug}/`}
                          class="text-accent hover:underline whitespace-nowrap"
                        >
                          View →
                        </a>
                      </td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </section>

      <!-- Methodology summary -->
      <section class="bg-surface border border-rule rounded-xl p-8 mb-8">
        <h2 class="text-2xl font-bold text-ink mb-4">How Scores Are Calculated</h2>
        <p class="text-muted leading-relaxed mb-6 text-sm">{methodology.description}</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {
            methodology.dimensions.map((dim) => (
              <div class="border border-rule rounded-lg p-4">
                <div class="text-2xl font-bold text-accent mb-1">{dim.weight}</div>
                <div class="text-sm font-bold text-ink">{dim.name}</div>
              </div>
            ))
          }
        </div>
        <p class="text-xs text-muted mt-4">
          Full methodology: <a href="/about/" class="text-accent hover:underline">About this tool</a
          >
        </p>
      </section>

      <!-- How to cite -->
      <section class="bg-surface border border-rule rounded-xl p-8 mb-8">
        <h2 class="text-2xl font-bold text-ink mb-4">How to Cite This Data</h2>
        <p class="text-muted text-sm mb-4 leading-relaxed">
          The {datasetMeta.name} is free to reuse for journalism, research, and analysis under
          <a
            href={datasetMeta.license}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent hover:underline">{datasetMeta.licenseLabel}</a
          > — attribution with a link to this page is required.
        </p>
        <div class="mb-4">
          <p class="text-xs font-bold text-ink uppercase tracking-wide mb-2">APA</p>
          <pre
            class="bg-paper border border-rule rounded-lg p-4 text-xs text-muted whitespace-pre-wrap break-all">{citationApa}</pre>
        </div>
        <div>
          <p class="text-xs font-bold text-ink uppercase tracking-wide mb-2">BibTeX</p>
          <pre
            class="bg-paper border border-rule rounded-lg p-4 text-xs text-muted overflow-x-auto">{citationBibtex}</pre>
        </div>
      </section>

      <!-- Changelog -->
      <section class="bg-surface border border-rule rounded-xl p-8 mb-8">
        <h2 class="text-2xl font-bold text-ink mb-4">Version History</h2>
        <ul class="space-y-4">
          {
            datasetMeta.changelog.map((entry) => (
              <li class="flex items-start gap-4 text-sm">
                <span class="flex-shrink-0 px-2 py-0.5 rounded bg-rule text-accent font-mono text-xs">
                  v{entry.version}
                </span>
                <div>
                  <p class="text-ink leading-relaxed">{entry.note}</p>
                  <p class="text-xs text-muted mt-1">{entry.date}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="text-center">
        <a
          href="/"
          class="inline-block px-8 py-4 rounded-lg border border-rule font-bold text-ink hover:border-accent hover:text-accent transition-all"
        >
          ← Check Your Career's Risk Score
        </a>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>
