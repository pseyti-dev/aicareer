---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CareerSelector from '../components/CareerSelector.jsx';
import {
  careers,
  specialOptions,
  methodology,
  marketStats,
  riskRankings,
  author,
  datasetMeta,
} from '../data/careers.js';
import { hicMeta, definitionShort, dimensions } from '../data/hic.js';
import { existsSync } from 'node:fs';

// Build-time check: show the portrait only when the file is actually present in
// public/, so a missing image can never ship as a broken <img>.
const hasPhoto = existsSync(new URL(`../../public${author.photo}`, import.meta.url));

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AI Career Risk Calculator',
  applicationCategory: 'BusinessApplication',
  url: 'https://aicareer.me',
  description:
    'Free tool to assess AI job displacement risk scores for specific careers and generate personalized upskilling roadmaps.',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: author.name },
  // Points answer engines from the homepage to the canonical definition.
  about: { '@id': hicMeta.canonicalUrl },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is a HI-C?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'HI-C stands for High-Impact Individual Contributor: a senior professional with no direct reports who carries work from hypothesis to measurable business outcome end to end, staffing the adjacent functions — design, engineering, data, copy, go-to-market — with AI rather than with a team. Where a traditional individual contributor owns one slice of a workflow, a HI-C owns the whole outcome. It is also written HI-IC or High Individual Contributor, and is unrelated to the AI-governance term Human-in-Command (HIC).',
      },
    },
    {
      '@type': 'Question',
      name: 'Which jobs are most at risk of AI automation?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The jobs most at risk of AI automation in 2026 are: Data Entry Clerk (95%), Bookkeeper (90%), Tax Preparer (88%), Customer Service Representative (82%), Administrative Assistant (82%), Accountant (80%), Paralegal (78%), and Content Writer (76%). These roles have the highest concentration of tasks that AI can already perform reliably. Roles like Registered Nurse (22%), Teacher (35%), and Cybersecurity Analyst (28%) score much lower and are considered well-protected.',
      },
    },
    {
      '@type': 'Question',
      name: 'How can I future-proof my career against AI?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'To future-proof your career against AI, focus on three areas: develop AI literacy and learn to use AI tools relevant to your field; shift toward human-judgment tasks like strategic thinking and client relationships; and acquire cross-functional skills in data analysis, project management, and communication.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is the AI risk score calculated?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Our AI risk score is a composite index built on three dimensions: Task Routinization (40%), AI Tool Penetration (35%), and Human Judgment Dependency (25%). Based on research by Oxford University, McKinsey Global Institute, and the World Economic Forum.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I reduce my AI displacement risk?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Our interactive tool lets you check off skills as you acquire them, and your personal risk score decreases accordingly. Professionals who proactively learn AI-adjacent skills typically reduce their displacement risk by 30-50 percentage points.',
      },
    },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://aicareer.me/',
    },
  ],
};

const getBarColor = (score) => {
  if (score <= 40) return 'rgb(var(--risk-low))';
  if (score <= 70) return 'rgb(var(--risk-mid))';
  return 'rgb(var(--risk-high))';
};
---

<BaseLayout
  title="What Replaces the Management Track: the HI-C | aicareer.me"
  description="AI absorbed the coordination work that made large teams necessary. The High-Impact Individual Contributor (HI-C) is the senior archetype replacing it — defined, versioned and open to cite. Plus AI displacement risk scores for 24 careers."
  canonical="https://aicareer.me/"
  schema={[orgSchema, faqSchema, breadcrumbSchema]}
>
  <Nav />

  <main>
    <!-- ── Hero ──
         Repositioned in Phase A: the site now answers "what replaces the
         management track", and the risk calculator moves below as the evidence
         that the old ladder is breaking (STRATEGY.md §3). -->
    <section class="mx-auto max-w-4xl px-6 py-16 sm:py-24">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-muted">
          <li><span class="font-medium text-ink" aria-current="page">Home</span></li>
        </ol>
      </nav>

      <h1
        class="mb-6 text-4xl font-bold leading-tight tracking-tight text-ink sm:text-5xl lg:text-6xl"
      >
        The management track is no longer<br class="hidden sm:block" />
        <span class="text-gradient">the only way up.</span>
      </h1>

      <p class="measure-wide mb-4 text-lg text-muted sm:text-xl">
        AI absorbed the coordination work that made large teams necessary. The senior archetype
        replacing it has a name: the <strong class="font-semibold text-ink"
          >High-Impact Individual Contributor</strong
        >.
      </p>
      <p class="measure-wide mb-8 text-base text-muted">{definitionShort}</p>

      <div class="mb-10 flex flex-wrap items-center gap-3">
        <a
          href="/hi-c/"
          class="lift inline-flex items-center gap-2 rounded-lg px-5 py-3 text-sm font-bold text-on-accent"
          style="background: linear-gradient(135deg, rgb(var(--accent-solid)) 0%, rgb(var(--accent-deep)) 100%)"
        >
          Read the definition →
        </a>
        <a
          href="#evidence"
          class="lift inline-flex items-center gap-2 rounded-lg border border-rule px-5 py-3 text-sm font-medium text-ink transition-colors hover:border-accent"
        >
          See the risk data
        </a>
      </div>

      <!-- Two versioned artifacts, stated as fact rather than as badges. -->
      <dl class="masthead">
        <div>
          <dt class="sr-only">Publication</dt>
          <dd class="!ml-0 font-semibold tracking-normal">Two open reference works</dd>
        </div>
        <div>
          <dt>HI-C framework</dt>
          <dd><a href="/hi-c/" class="hover:text-accent">v{hicMeta.version}</a></dd>
        </div>
        <div>
          <dt>Risk index</dt>
          <dd>
            <a href={datasetMeta.canonicalUrl} class="hover:text-accent">v{datasetMeta.version}</a>
          </dd>
        </div>
        <div>
          <dt class="sr-only">Licence</dt>
          <dd class="!ml-0">{hicMeta.licenseLabel}</dd>
        </div>
      </dl>
    </section>

    <!-- ── The five dimensions — "how close are you" without promising a score
         that does not exist yet (the Readiness Index is Phase C). ── -->
    <section aria-labelledby="dimensions" class="border-y border-rule bg-paper-alt py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <h2 id="dimensions" class="mb-3 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          Where do you stand?
        </h2>
        <p class="measure mb-8 text-base leading-relaxed text-muted">
          A HI-C is easier to recognise than to define by title. These five dimensions are
          observable — each describes something you either can or cannot currently do.
        </p>

        <ol class="mb-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            dimensions.map((d, i) => (
              <li class="lift rounded-xl border border-rule bg-surface p-5">
                <div class="mb-2 flex items-baseline gap-2">
                  <span class="tnum text-xs font-semibold text-accent">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="text-base font-bold text-ink">{d.name}</h3>
                </div>
                <p class="text-sm leading-relaxed text-muted">{d.question}</p>
              </li>
            ))
          }
        </ol>

        <a
          href="/hi-c/#dimensions"
          class="text-sm font-medium text-accent underline decoration-rule underline-offset-4 transition-colors hover:decoration-accent"
        >
          See what the higher end of each dimension looks like →
        </a>
      </div>
    </section>

    <!-- ── The evidence: the risk calculator, reframed ── -->
    <section aria-labelledby="evidence-heading" class="mx-auto max-w-4xl px-6 py-16" id="evidence">
      <h2 id="evidence-heading" class="mb-3 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        The other side of the same shift
      </h2>
      <p class="measure mb-8 text-base leading-relaxed text-muted">
        The roles losing the most ground are the ones defined by coordination and routine execution
        — exactly the work the HI-C model removes from the org chart. The
        <a
          href={datasetMeta.canonicalUrl}
          class="text-accent underline decoration-rule underline-offset-2 hover:decoration-accent"
          >{datasetMeta.name}</a
        > scores 24 professions on how exposed their task load is to automation. Check yours:
      </p>

      <div class="neon-glow mx-auto max-w-xl rounded-2xl border border-rule bg-surface p-4">
        <CareerSelector client:load careers={careers} specialOptions={specialOptions} />
      </div>
    </section>

    <!-- ── Market Stats ── -->
    <section class="border-t border-rule bg-paper-alt py-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-4">
            <h2 class="text-2xl sm:text-3xl font-bold mb-4 tracking-tight text-gradient">
              The Impact of AI on the Job Market in 2026
            </h2>
            <p class="text-muted leading-relaxed">
              The AI-driven transformation of the labor market is accelerating faster than most
              workers realize.
            </p>
          </div>
          <div class="lg:col-span-8 grid grid-cols-2 md:grid-cols-3 gap-4">
            {
              marketStats.map((stat) => (
                <div class="bg-surface border border-rule rounded-2xl p-5 text-center">
                  <div class="text-3xl font-bold text-accent mb-1">{stat.figure}</div>
                  <div class="text-sm text-ink mb-2 leading-snug">{stat.label}</div>
                  <div class="text-xs text-muted">— {stat.source}</div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ── Career Cards ── -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h2 class="text-2xl sm:text-3xl font-bold text-ink mb-3 text-center tracking-tight">
        AI Risk Score by Career — 2026
      </h2>
      <p class="text-muted text-center mb-10 max-w-2xl mx-auto">
        24 careers analyzed — from critical risk to well-protected. Each has a dedicated assessment
        with specific skills to reduce your personal score.
      </p>

      <!-- AIO crawlable summary -->
      <div class="sr-only">
        {
          riskRankings.map((r) => (
            <p>
              #{r.rank}: The AI replacement risk for a {r.title} is {r.risk}% due to {r.reason}.
            </p>
          ))
        }
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          careers.map((career) => {
            const color = getBarColor(career.baseRiskScore);
            return (
              <a
                href={`/risk/${career.slug}/`}
                aria-label={`${career.title} AI risk assessment — ${career.baseRiskScore}% risk`}
                class="block bg-surface border border-rule rounded-2xl p-6 text-left transition-all duration-200 hover:border-accent hover:scale-[1.02] hover:shadow-[0_0_24px_rgb(var(--accent-solid)/0.1)] group"
              >
                <h3 class="text-lg font-bold text-ink mb-2 group-hover:text-accent transition-colors">
                  {career.title}
                </h3>
                <p class="text-xs text-muted mb-4 line-clamp-2">{career.aioSummary}</p>
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-2xl font-bold text-ink">{career.baseRiskScore}%</span>
                  <span
                    class="px-2 py-1 rounded text-xs font-bold uppercase"
                    style={`background-color:${color}20;color:${color}`}
                  >
                    {career.riskLabel}
                  </span>
                </div>
                <div class="w-full h-1 bg-rule rounded-full overflow-hidden">
                  <div
                    class="h-full rounded-full"
                    style={`width:${career.baseRiskScore}%;background-color:${color};box-shadow:0 0 6px ${color}80`}
                  />
                </div>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- ── Future-Proof Framework ── -->
    <section class="border-t border-rule bg-paper-alt py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-ink mb-3 text-center tracking-tight">
          How to Future-Proof Your Career Against AI
        </h2>
        <p class="text-muted text-center mb-10 max-w-2xl mx-auto">
          The professionals who thrive in the AI era aren't those who avoid AI — they're the ones
          who learn to work alongside it.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            [
              {
                step: '01',
                title: 'Know Your Risk',
                desc: 'Start by honestly assessing how much of your current work is routine and predictable. Our calculator gives you a baseline score based on your profession.',
                color: 'rgb(var(--risk-high))',
              },
              {
                step: '02',
                title: 'Learn AI Tools',
                desc: 'Master the AI tools entering your industry. Becoming the person who runs the AI — rather than being replaced by it — requires deliberate skill-building.',
                color: 'rgb(var(--risk-mid))',
              },
              {
                step: '03',
                title: 'Shift to Human Work',
                desc: 'Move your career toward tasks requiring judgment, creativity, trust, and emotional intelligence. These are the domains where AI still falls short.',
                color: 'rgb(var(--risk-low))',
              },
            ].map((item) => (
              <div class="bg-surface border border-rule rounded-2xl p-6">
                <div class="text-4xl font-bold mb-3" style={`color:${item.color}`}>
                  {item.step}
                </div>
                <h3 class="text-lg font-bold text-ink mb-2">{item.title}</h3>
                <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── Methodology ── -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16" id="methodology">
      <div class="text-center mb-16">
        <h2 class="text-2xl sm:text-3xl font-bold text-ink mb-4 tracking-tight">
          {methodology.title}
        </h2>
        <p class="text-muted max-w-2xl mx-auto">{methodology.description}</p>
      </div>
      <div class="grid gap-6 mb-6">
        {
          methodology.dimensions.map((dim) => (
            <div class="flex items-start gap-6 p-6 rounded-2xl border border-rule bg-paper">
              <div class="flex-shrink-0">
                <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-accent/10 text-accent border border-accent/30">
                  {dim.weight}
                </span>
              </div>
              <div>
                <h3 class="font-bold text-ink mb-1">{dim.name}</h3>
                <p class="text-sm text-muted leading-relaxed">{dim.description}</p>
              </div>
            </div>
          ))
        }
      </div>
      <div class="bg-surface border border-rule border-l-4 border-l-accent rounded-2xl p-5">
        <p class="text-sm text-muted leading-relaxed">
          <span class="text-ink font-medium">Note: </span>{methodology.note}
        </p>
      </div>
    </section>

    <!-- ── About / E-E-A-T ── -->
    <section class="border-t border-rule bg-paper-alt py-16" id="about">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-ink mb-6 tracking-tight">Who Built This</h2>
        <div class="bg-surface border border-rule rounded-2xl p-8">
          {
            hasPhoto ? (
              <img
                src={author.photo}
                alt={`${author.name}, author of aicareer.me`}
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
                class="mx-auto mb-4 h-16 w-16 rounded-full border border-rule object-cover"
              />
            ) : (
              <div
                class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full text-2xl font-bold text-on-accent"
                style="background: linear-gradient(135deg, rgb(var(--accent-solid)), rgb(var(--accent-deep)))"
              >
                {author.name.charAt(0)}
              </div>
            )
          }
          <h3 class="text-xl font-bold text-ink mb-1">
            <a
              href={author.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-rule underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
              >{author.name}</a
            >
          </h3>
          <p class="text-sm text-accent mb-4">{author.role}</p>
          <p class="text-muted leading-relaxed mb-6">{author.bio}</p>
          <div class="flex flex-wrap justify-center gap-2 mb-6">
            {
              author.expertise.map((skill) => (
                <span class="px-3 py-1 rounded-full text-xs font-medium bg-rule text-ink">
                  {skill}
                </span>
              ))
            }
          </div>
          <p class="text-xs text-muted">
            This tool covers career topics (YMYL). Scores are based on published labor economics
            research for informational purposes only.
          </p>
        </div>
      </div>
    </section>

    <!-- ── FAQ ── -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h2 class="text-2xl sm:text-3xl font-bold text-ink mb-10 text-center tracking-tight">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {
          faqSchema.mainEntity.map((item) => (
            <div class="bg-surface border border-rule rounded-2xl p-6">
              <h3 class="font-bold text-ink mb-3">{item.name}</h3>
              <p class="text-sm text-muted leading-relaxed">{item.acceptedAnswer.text}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
