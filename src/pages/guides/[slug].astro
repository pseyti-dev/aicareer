---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { guides } from '../../data/guides.js';
import { author } from '../../data/careers.js';
import { hicMeta } from '../../data/hic.js';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const url = `https://aicareer.me/guides/${guide.slug}/`;

// Minimal inline emphasis for authored copy. The source is this repository, not
// user input, so set:html carries no injection surface here.
const md = (s) => s.replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-ink">$1</strong>');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.h1,
  description: guide.metaDescription,
  url,
  author: { '@type': 'Person', name: author.name, url: author.linkedin },
  publisher: { '@type': 'Organization', name: 'aicareer.me', url: 'https://aicareer.me' },
  datePublished: '2026-08-13',
  dateModified: '2026-08-13',
  license: hicMeta.license,
  mentions: { '@id': hicMeta.canonicalUrl },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aicareer.me/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://aicareer.me/guides/' },
    { '@type': 'ListItem', position: 3, name: guide.title, item: url },
  ],
};
---

<BaseLayout
  title={guide.metaTitle}
  description={guide.metaDescription}
  canonical={url}
  ogType="article"
  schema={[articleSchema, faqSchema, breadcrumbSchema]}
>
  <Nav />

  <div class="min-h-screen bg-paper">
    <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-x-2 text-sm text-muted">
          <li><a href="/" class="transition-colors hover:text-accent">Home</a></li>
          <li><span class="text-rule">/</span></li>
          <li><a href="/guides/" class="transition-colors hover:text-accent">Guides</a></li>
          <li><span class="text-rule">/</span></li>
          <li><span class="font-medium text-ink" aria-current="page">{guide.title}</span></li>
        </ol>
      </nav>

      <header class="mb-10">
        <h1 class="mb-4 text-3xl font-bold text-ink sm:text-4xl lg:text-5xl">{guide.h1}</h1>
        <p class="measure mb-6 text-lg text-muted">{guide.intent}</p>
        <p class="measure-wide text-base leading-relaxed text-ink" set:html={md(guide.lede)} />
      </header>

      {
        guide.sections.map((section) => (
          <section class="mb-12">
            <h2 class="mb-4 text-2xl font-bold text-ink">{section.heading}</h2>

            {section.table && (
              <div class="mb-6 overflow-x-auto rounded-xl border border-rule">
                <table class="w-full min-w-[38rem] border-collapse text-sm">
                  <thead>
                    <tr class="border-b border-rule bg-paper-alt">
                      {section.table.columns.map((c, i) => (
                        <th
                          scope="col"
                          class={`px-4 py-3 text-left font-semibold ${i === 1 ? 'text-accent' : 'text-muted'}`}
                        >
                          {c}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {section.table.rows.map((r) => (
                      <tr class="border-b border-rule last:border-0">
                        <th scope="row" class="px-4 py-3 text-left font-medium text-muted">
                          {r.label}
                        </th>
                        {r.values.map((v, i) => (
                          <td
                            class={`px-4 py-3 ${i === 0 ? 'font-medium text-ink' : 'text-muted'}`}
                          >
                            {v}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {section.body?.map((p) => (
              <p class="measure-wide mb-4 text-base leading-relaxed text-muted" set:html={md(p)} />
            ))}

            {section.list && (
              <ol class="mt-4 space-y-3">
                {section.list.map((item, i) => (
                  <li class="lift rounded-xl border border-rule bg-surface p-5">
                    <div class="flex gap-3">
                      <span class="tnum shrink-0 text-sm font-semibold text-accent">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      <p class="text-sm leading-relaxed text-muted" set:html={md(item)} />
                    </div>
                  </li>
                ))}
              </ol>
            )}
          </section>
        ))
      }

      <section aria-labelledby="faq-heading" class="mb-12">
        <h2 id="faq-heading" class="mb-6 text-2xl font-bold text-ink">
          Frequently asked questions
        </h2>
        <dl class="space-y-6">
          {
            guide.faq.map((f) => (
              <div class="border-b border-rule pb-6 last:border-0">
                <dt class="mb-2 text-lg font-bold text-ink">{f.q}</dt>
                <dd class="measure-wide text-base leading-relaxed text-muted">{f.a}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="related-heading" class="mb-12">
        <h2 id="related-heading" class="mb-4 text-2xl font-bold text-ink">Keep reading</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {
            guide.related.map((r) => (
              <li>
                <a
                  href={r.href}
                  class="lift block rounded-xl border border-rule bg-surface p-5 font-medium text-ink transition-colors hover:border-accent"
                >
                  {r.label} <span class="text-accent">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </div>

  <Footer />
</BaseLayout>
