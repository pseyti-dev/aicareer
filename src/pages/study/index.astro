---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { author } from '../../data/careers.js';

// Index page for the studies directory. Before this existed, /study/ was a
// directory with no index.html, so the server returned 403 — Google flagged it
// after probing the parent path of the two study pages. This turns that 403
// into a real hub page (and adds internal linking), mirroring /guides/.
const url = 'https://aicareer.me/study/';

const studies = [
  {
    slug: 'ai-job-impact-2026',
    title: "AI's Real Impact on Jobs in 2026",
    summary:
      'The Stanford AI Index 2026 crossed with the 24 career risk scores: junior developer employment down ~20%, one in three companies planning AI-driven cuts, and which roles are most exposed.',
  },
  {
    slug: 'careers-by-industry',
    title: 'AI Displacement Risk by Industry',
    summary:
      'The 24 careers grouped into industry sectors, with the average AI risk per sector. Finance & Accounting leads at ~70%, with Stanford AI Index 2026 context throughout.',
  },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Research & studies',
  description:
    'Original research crossing the AI Career Risk Index with the Stanford AI Index 2026 — job-market impact and displacement risk by industry sector.',
  url,
  author: { '@type': 'Person', name: author.name, url: author.linkedin },
  hasPart: studies.map((s) => ({
    '@type': 'Article',
    headline: s.title,
    url: `https://aicareer.me/study/${s.slug}/`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://aicareer.me/' },
    { '@type': 'ListItem', position: 2, name: 'Research', item: url },
  ],
};
---

<BaseLayout
  title="Research & Studies: AI Job Impact and Risk by Industry | aicareer.me"
  description="Original research crossing the AI Career Risk Index with the Stanford AI Index 2026: what the job-market data actually shows, and AI displacement risk by industry sector."
  canonical={url}
  schema={[collectionSchema, breadcrumbSchema]}
>
  <Nav />

  <div class="min-h-screen bg-paper">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-muted">
          <li><a href="/" class="transition-colors hover:text-accent">Home</a></li>
          <li><span class="mx-2 text-rule">/</span></li>
          <li><span class="font-medium text-ink" aria-current="page">Research</span></li>
        </ol>
      </nav>

      <header class="mb-10">
        <h1 class="mb-4 text-3xl font-bold text-ink sm:text-4xl lg:text-5xl">
          Research &amp; studies
        </h1>
        <p class="measure text-lg leading-relaxed text-muted">
          Original analysis crossing the <a
            href="/data/ai-career-risk-index/"
            class="text-accent underline decoration-rule underline-offset-2 hover:decoration-accent"
            >AI Career Risk Index</a
          > with the Stanford AI Index 2026 — what the job-market data actually shows, and how displacement
          risk splits by industry.
        </p>
      </header>

      <ul class="space-y-4">
        {
          studies.map((s) => (
            <li>
              <a
                href={`/study/${s.slug}/`}
                class="lift block rounded-xl border border-rule bg-surface p-6 transition-colors hover:border-accent"
              >
                <h2 class="mb-2 text-xl font-bold text-ink">{s.title}</h2>
                <p class="measure text-sm leading-relaxed text-muted">{s.summary}</p>
                <span class="mt-3 inline-block text-sm font-medium text-accent">Read →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <Footer />
</BaseLayout>
