---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Served with a real 404 status via .htaccess (ErrorDocument 404 /404.html),
// replacing the previous soft-404 that returned the homepage with a 200.
const links = [
  { label: 'What is a HI-C?', href: '/hi-c/', note: 'The canonical definition' },
  { label: 'Career track guides', href: '/guides/', note: 'Staff vs manager, the IC ladder' },
  { label: 'AI Career Risk Index', href: '/data/ai-career-risk-index/', note: 'The open dataset' },
  { label: 'Home', href: '/', note: 'Start over' },
];
---

<BaseLayout
  title="Page not found | aicareer.me"
  description="That page does not exist. Find the HI-C definition, the career guides, or the AI Career Risk Index instead."
  canonical="https://aicareer.me/404"
>
  <Nav />

  <div class="min-h-screen bg-paper">
    <div class="mx-auto max-w-2xl px-4 py-24 sm:px-6 lg:px-8">
      <p class="tnum mb-4 text-sm font-semibold uppercase tracking-widest text-accent">Error 404</p>
      <h1 class="mb-4 text-3xl font-bold text-ink sm:text-4xl">This page does not exist</h1>
      <p class="measure mb-10 text-lg leading-relaxed text-muted">
        The link may be broken or the page may have moved. Here is where most people are headed:
      </p>

      <ul class="space-y-3">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="lift flex items-center justify-between rounded-xl border border-rule bg-surface p-5 transition-colors hover:border-accent"
              >
                <span>
                  <span class="block font-semibold text-ink">{l.label}</span>
                  <span class="block text-sm text-muted">{l.note}</span>
                </span>
                <span class="text-accent">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <Footer />
</BaseLayout>
